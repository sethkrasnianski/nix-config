# Nix build symlinks
result
result-*

# Editor/OS cruft
*.swp
.DS_Store

# direnv's machine-local environment and cached flake state
.direnv/

# Claude Code local project state (worktrees, local settings); the rest of
# .claude/ (commands, agents, skills) is shareable and stays trackable
.claude/settings.local.json
.claude/worktrees/
agents/skills/synced/

# Host-specific agent instructions, never committed
CLAUDE.local.md
AGENTS.local.md

# agent-shell session transcripts — session logs can capture sensitive
# content; ignored here (tracked) so fresh clones are protected too, not
# just via the local-only .git/info/exclude
.agent-shell/
